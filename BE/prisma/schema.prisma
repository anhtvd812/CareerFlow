generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              UserRole           @default(STUDENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roadmaps          Roadmap[]
  assessmentResults AssessmentResult[]
  mentorProfile     Mentor?
  userTasks         UserTask[]
}

model Career {
  id                String             @id @default(cuid())
  title             String
  description       String
  outlook           String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roadmaps          Roadmap[]
  assessmentResults AssessmentResult[]
  careerSkills      CareerSkill[]
}

model Skill {
  id            String         @id @default(cuid())
  name          String
  description   String?
  careerSkills  CareerSkill[]
  roadmapSkills RoadmapSkill[]
}

model Roadmap {
  id            String         @id @default(cuid())
  title         String
  summary       String?
  userId        String
  careerId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  career        Career         @relation(fields: [careerId], references: [id])
  roadmapSkills RoadmapSkill[]
  stages        Stage[]
  userTasks     UserTask[]
}

model Stage {
  id          String   @id @default(cuid())
  roadmapId   String
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id])
  userTasks   UserTask[]
}

model UserTask {
  id        String     @id @default(cuid())
  userId    String
  roadmapId String
  stageId   String
  title     String
  type      String?
  status    TaskStatus @default(NOT_STARTED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id])
  stage     Stage      @relation(fields: [stageId], references: [id])

  @@index([roadmapId, userId])
  @@index([stageId])
}

model Mentor {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String?
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model AssessmentResult {
  id        String   @id @default(cuid())
  userId    String
  careerId  String
  score     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  career    Career   @relation(fields: [careerId], references: [id])
}

model CareerSkill {
  id       String @id @default(cuid())
  careerId String
  skillId  String
  level    Int    @default(1)
  career   Career @relation(fields: [careerId], references: [id])
  skill    Skill  @relation(fields: [skillId], references: [id])

  @@unique([careerId, skillId])
}

model RoadmapSkill {
  id          String  @id @default(cuid())
  roadmapId   String
  skillId     String
  targetLevel Int     @default(1)
  progress    Int     @default(0)
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id])
  skill       Skill   @relation(fields: [skillId], references: [id])

  @@unique([roadmapId, skillId])
}
