generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
 
enum QuestionType {
  MULTIPLE_CHOICE
  TEXT
}

enum TextMatchMode {
  EXACT
  KEYWORD
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

enum UserSkillSource {
  MANUAL
  ASSESSMENT
  ROADMAP
  CERTIFICATION
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  name              String
  role              UserRole           @default(STUDENT)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roadmaps          Roadmap[]
  userSkills        UserSkill[]
  assessmentResults AssessmentResult[]
  assessmentAnswers UserAnswer[]
  assessmentAttempts AssessmentAttempt[]
  mentorProfile     Mentor?
  userTasks         UserTask[]
  profile           UserProfile?
  certifications    UserCertification[]
}

model Career {
  id                String             @id @default(cuid())
  title             String
  description       String             @db.Text
  outlook           String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  roadmaps          Roadmap[]
  assessmentResults AssessmentResult[]
  careerSkills      CareerSkill[]
  goalProfiles      UserProfile[]
}

model Skill {
  id                  String               @id @default(cuid())
  name                String               @unique
  description         String?              @db.Text
  careerSkills        CareerSkill[]
  roadmapSkills       RoadmapSkill[]
  userSkills          UserSkill[]
  courseSkills        CourseSkill[]
  sampleProjectSkills SampleProjectSkill[]
}

model Course {
  id             String        @id @default(cuid())
  title          String
  description    String?       @db.Text
  difficulty     String
  estimatedHours Int?
  url            String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  courseSkills   CourseSkill[]
}

model CourseSkill {
  id       String @id @default(cuid())
  courseId String
  skillId  String
  course   Course @relation(fields: [courseId], references: [id])
  skill    Skill  @relation(fields: [skillId], references: [id])

  @@unique([courseId, skillId])
  @@index([skillId])
}

model SampleProject {
  id                  String               @id @default(cuid())
  title               String
  description         String?              @db.Text
  difficulty          String
  estimatedHours      Int?
  instructions        String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sampleProjectSkills SampleProjectSkill[]
}

model SampleProjectSkill {
  id              String        @id @default(cuid())
  sampleProjectId String
  skillId         String
  sampleProject   SampleProject @relation(fields: [sampleProjectId], references: [id])
  skill           Skill         @relation(fields: [skillId], references: [id])

  @@unique([sampleProjectId, skillId])
  @@index([skillId])
}

model Roadmap {
  id            String         @id @default(cuid())
  title         String
  summary       String?        @db.Text
  userId        String
  careerId      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id])
  career        Career         @relation(fields: [careerId], references: [id])
  roadmapSkills RoadmapSkill[]
  stages        Stage[]
  userTasks     UserTask[]
}

model Stage {
  id          String   @id @default(cuid())
  roadmapId   String
  name        String
  description String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id])
  userTasks   UserTask[]
}

model UserTask {
  id        String     @id @default(cuid())
  userId    String
  roadmapId String
  stageId   String
  title     String
  type      String?
  status    TaskStatus @default(NOT_STARTED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  roadmap   Roadmap    @relation(fields: [roadmapId], references: [id])
  stage     Stage      @relation(fields: [stageId], references: [id])

  @@index([roadmapId, userId])
  @@index([stageId])
}

model Mentor {
  id        String   @id @default(cuid())
  userId    String   @unique
  headline  String?  @db.Text
  bio       String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Assessment {
  id                  String                        @id @default(cuid())
  title               String                        @db.Text
  description         String?                       @db.Text
  isActive            Boolean                       @default(true)
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  questions           AssessmentQuestion[]
  results             AssessmentResult[]
  answers             UserAnswer[]
  attempts            AssessmentAttempt[]
  classificationRules AssessmentClassificationRule[]
}

model SkillCategory {
  id            String                 @id @default(cuid())
  name          String                 @unique
  description   String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  questions     AssessmentQuestion[]
  resultScores  AssessmentResultCategory[]
}

model AssessmentQuestion {
  id               String           @id @default(cuid())
  assessmentId     String
  prompt           String           @db.Text
  type             QuestionType
  weight           Float            @default(1)
  skillCategoryId  String?
  textAnswer       String?          @db.Text
  textMatchMode    TextMatchMode?   @default(KEYWORD)
  minKeywordScore  Int?             @default(1)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assessment       Assessment       @relation(fields: [assessmentId], references: [id])
  skillCategory    SkillCategory?   @relation(fields: [skillCategoryId], references: [id])
  choices          QuestionChoice[]
  keywords         QuestionKeyword[]
  answers          UserAnswer[]
  attemptAnswers   AssessmentAttemptAnswer[]
}

model QuestionChoice {
  id            String       @id @default(cuid())
  questionId    String
  label         String       @db.Text
  value         String       @db.Text
  isCorrect     Boolean      @default(false)
  scoreWeight   Float        @default(1)
  question      AssessmentQuestion @relation(fields: [questionId], references: [id])
  answers       UserAnswer[]
  attemptAnswers AssessmentAttemptAnswer[]
}

model QuestionKeyword {
  id         String             @id @default(cuid())
  questionId String
  keyword    String             @db.Text
  weight     Float              @default(1)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id])
}

model AssessmentResult {
  id            String                    @id @default(cuid())
  userId        String
  assessmentId  String
  attemptId     String?                   @unique
  careerId      String?
  classificationId String?
  totalScore    Float
  maxScore      Float
  percentage    Float
  correctCount  Int
  incorrectCount Int
  summary       String?                   @db.Text
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  user          User                      @relation(fields: [userId], references: [id])
  assessment    Assessment                @relation(fields: [assessmentId], references: [id])
  attempt       AssessmentAttempt?        @relation(fields: [attemptId], references: [id])
  career        Career?                   @relation(fields: [careerId], references: [id])
  classification Classification?          @relation(fields: [classificationId], references: [id])
  profile        UserProfile?             @relation("ProfileLastAssessment")
  answers       UserAnswer[]
  categoryScores AssessmentResultCategory[]
}

model UserProfile {
  id                     String            @id @default(cuid())
  userId                 String            @unique
  headline               String?           @db.Text
  bio                    String?           @db.Text
  careerGoal             String?           @db.Text
  careerGoalId           String?
  progressPercent        Float             @default(0)
  lastAssessmentResultId String?           @unique
  lastAssessmentTakenAt  DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  user                   User              @relation(fields: [userId], references: [id])
  careerGoalRef          Career?           @relation(fields: [careerGoalId], references: [id])
  lastAssessmentResult   AssessmentResult? @relation("ProfileLastAssessment", fields: [lastAssessmentResultId], references: [id])

  @@index([careerGoalId])
}

model UserSkill {
  id        String          @id @default(cuid())
  userId    String
  skillId   String
  level     Int             @default(1)
  source    UserSkillSource @default(MANUAL)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  skill     Skill           @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([skillId])
}

model UserCertification {
  id             String   @id @default(cuid())
  userId         String
  name           String   @db.Text
  issuer         String?  @db.Text
  issuedAt       DateTime?
  expiresAt      DateTime?
  credentialUrl  String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AssessmentAttempt {
  id            String                  @id @default(cuid())
  assessmentId  String
  userId        String
  status        AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  assessment    Assessment              @relation(fields: [assessmentId], references: [id])
  user          User                    @relation(fields: [userId], references: [id])
  answers       AssessmentAttemptAnswer[]
  result        AssessmentResult?

  @@index([assessmentId])
  @@index([userId])
}

model AssessmentAttemptAnswer {
  id               String            @id @default(cuid())
  attemptId        String
  questionId       String
  selectedChoiceId String?
  answerText       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id])
  question         AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedChoice   QuestionChoice?   @relation(fields: [selectedChoiceId], references: [id])

  @@unique([attemptId, questionId])
}

model AssessmentResultCategory {
  id                 String            @id @default(cuid())
  assessmentResultId String
  skillCategoryId    String
  score              Float
  maxScore           Float
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id])
  skillCategory      SkillCategory    @relation(fields: [skillCategoryId], references: [id])

  @@unique([assessmentResultId, skillCategoryId])
}

model UserAnswer {
  id                 String            @id @default(cuid())
  assessmentResultId String
  assessmentId       String
  questionId         String
  userId             String
  selectedChoiceId   String?
  answerText         String?          @db.Text
  isCorrect          Boolean
  score              Float
  createdAt          DateTime          @default(now())
  assessmentResult   AssessmentResult  @relation(fields: [assessmentResultId], references: [id])
  assessment         Assessment        @relation(fields: [assessmentId], references: [id])
  question           AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedChoice     QuestionChoice?   @relation(fields: [selectedChoiceId], references: [id])
  user               User              @relation(fields: [userId], references: [id])

  @@unique([assessmentResultId, questionId])
}

model Classification {
  id          String                        @id @default(cuid())
  name        String                        @unique
  description String?                       @db.Text
  isDefault   Boolean                       @default(false)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  rules       AssessmentClassificationRule[]
  results     AssessmentResult[]
}

model AssessmentClassificationRule {
  id                     String          @id @default(cuid())
  assessmentId           String
  classificationId       String
  careerId               String?
  priority               Int             @default(0)
  minPercentage          Float?
  maxPercentage          Float?
  minCorrect             Int?
  maxIncorrect           Int?
  minCategoryPercentages Json?
  maxCategoryPercentages Json?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  assessment             Assessment      @relation(fields: [assessmentId], references: [id])
  classification         Classification  @relation(fields: [classificationId], references: [id])
  career                 Career?         @relation(fields: [careerId], references: [id])

  @@index([assessmentId])
  @@index([classificationId])
  @@index([careerId])
}

model CareerSkill {
  id       String @id @default(cuid())
  careerId String
  skillId  String
  level    Int    @default(1)
  career   Career @relation(fields: [careerId], references: [id])
  skill    Skill  @relation(fields: [skillId], references: [id])

  @@unique([careerId, skillId])
}

model RoadmapSkill {
  id          String  @id @default(cuid())
  roadmapId   String
  skillId     String
  targetLevel Int     @default(1)
  progress    Int     @default(0)
  roadmap     Roadmap @relation(fields: [roadmapId], references: [id])
  skill       Skill   @relation(fields: [skillId], references: [id])

  @@unique([roadmapId, skillId])
}

model UserSkill {
  id        String          @id @default(cuid())
  userId    String
  skillId   String
  level     Int             @default(1)
  source    UserSkillSource
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id])
  skill     Skill           @relation(fields: [skillId], references: [id])
}
